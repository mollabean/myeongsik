# 필수: Anthropic Console(console.anthropic.com)에서 만든 API 키
ANTHROPIC_API_KEY=

# 선택: 사용할 모델 (기본값은 api/reading.js 참고)
# MODEL_MAIN=claude-sonnet-5-5
# MODEL_QUICK=claude-haiku-4-5-20251001

# 선택: 호출 제한 (기본값: IP당 시간 20회, 하루 60회, 전체 하루 1000회)
# LIMIT_PER_IP_HOUR=20
# LIMIT_PER_IP_DAY=60
# LIMIT_GLOBAL_DAY=1000

# 선택: 여러 서버 인스턴스에 공통으로 호출 제한을 걸려면 Upstash Redis 연결
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# 선택: 내 도메인에서 온 요청만 받기 (쉼표로 구분)
# ALLOWED_ORIGINS=https://myeongsik.vercel.app,https://내도메인.com
